        <mxCell id="leyenda" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;-&lt;/b&gt; atributo privado (prefijo _ en Python)&lt;br&gt;&lt;b&gt;+&lt;/b&gt; miembro público&lt;br&gt;«get» propiedad de solo lectura&lt;br&gt;«get/set» propiedad con setter que valida&lt;br&gt;«get, calculado» propiedad calculada (no se guarda)&lt;br&gt;&lt;i&gt;cursiva&lt;/i&gt; método o propiedad abstracta&lt;br&gt;&lt;u&gt;subrayado&lt;/u&gt; miembro de clase (estático)&lt;br&gt;Flecha con triángulo hueco: herencia («es un»)&lt;br&gt;Flecha punteada: referencia solo por código (texto)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
